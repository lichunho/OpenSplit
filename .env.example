# Copy to .env and fill in real values for local overrides.
# Neither value is required for local dev: DATABASE_URL falls back to a local
# SQLite file, and SECRET_KEY falls back to a generated dev key.

# Local: sqlite:///./app.db
# Prod (Neon, pooled host — must contain "-pooler"):
# postgresql://user:password@ep-example-123456-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=sqlite:///./app.db

# Any random string; regenerate for real deployments.
SECRET_KEY=replace-with-a-real-secret-in-production

# Session cookie Secure flag. Must stay false for local http://127.0.0.1 dev
# (a Secure cookie is silently dropped over plain http). Production MUST set
# this to true.
SESSION_HTTPS_ONLY=false
